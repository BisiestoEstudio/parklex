<wpml-config>
	<custom-fields>
		<!-- products -->
		<custom-field action="copy">gallery</custom-field>
		<custom-field action="copy">_gallery</custom-field>

		<!-- proyecto: "Project Info" group (ID fields mapped per language in Bis_Core_WPML_Fields) -->
		<custom-field action="copy">project_info</custom-field>
		<custom-field action="copy">_project_info</custom-field>
		<custom-field action="copy">project_info_year</custom-field>
		<custom-field action="copy">_project_info_year</custom-field>
		<custom-field action="translate">project_info_location</custom-field>
		<custom-field action="copy">_project_info_location</custom-field>
		<custom-field action="copy">project_info_product</custom-field>
		<custom-field action="copy">_project_info_product</custom-field>
		<custom-field action="copy">project_info_related_product</custom-field>
		<custom-field action="copy">_project_info_related_product</custom-field>
		<custom-field action="copy">project_info_awards</custom-field>
		<custom-field action="copy">_project_info_awards</custom-field>
		<custom-field action="copy">project_info_photography</custom-field>
		<custom-field action="copy">_project_info_photography</custom-field>

		<!-- technical-card: attachment IDs mapped per language in Bis_Core_WPML_Fields -->
		<custom-field action="copy-once">downloads</custom-field>
		<custom-field action="copy-once">_downloads</custom-field>
		<custom-field action="copy-once">image</custom-field>
		<custom-field action="copy-once">_image</custom-field>
	</custom-fields>
	<custom-term-fields>
		<custom-term-field action="copy">card_type</custom-term-field>
		<custom-term-field action="copy">disable_label</custom-term-field>
	</custom-term-fields>
</wpml-config>
